def visualize_samples(data_dir, split='train', samples_per_class=3):
    """Visualize sample images from each class."""
    split_dir = data_dir / split
    if not split_dir.exists():
        print(f"Split directory {split} not found")
        return
    
    class_dirs = [d for d in split_dir.iterdir() if d.is_dir()]
    if not class_dirs:
        print(f"No class directories found in {split}")
        return
    
    num_classes = len(class_dirs)
    fig, axes = plt.subplots(num_classes, samples_per_class, 
                           figsize=(samples_per_class * 3, num_classes * 3))
    
    if num_classes == 1:
        axes = axes.reshape(1, -1)
    
    for i, class_dir in enumerate(class_dirs):
        image_files = [f for f in class_dir.glob('*') 
                      if f.suffix.lower() in ['.jpg', '.jpeg', '.png', '.bmp', '.tiff']]
        
        for j in range(samples_per_class):
            if j < len(image_files):
                try:
                    img = Image.open(image_files[j])
                    axes[i, j].imshow(img)
                    axes[i, j].set_title(f'{class_dir.name} - {image_files[j].name}')
                except Exception as e:
                    axes[i, j].text(0.5, 0.5, f'Error loading\n{str(e)}', 
                                   ha='center', va='center')
            else:
                axes[i, j].text(0.5, 0.5, 'No image', ha='center', va='center')
            
            axes[i, j].axis('off')
    
    plt.tight_layout()
    plt.show()

