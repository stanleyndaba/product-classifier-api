def plot_class_distribution(dataset_info):
    """Plot class distribution across splits."""
    fig, axes = plt.subplots(1, len(dataset_info), figsize=(15, 5))
    if len(dataset_info) == 1:
        axes = [axes]
    
    for i, (split, classes) in enumerate(dataset_info.items()):
        if classes:  # Only plot if there are classes
            class_names = list(classes.keys())
            counts = list(classes.values())
            
            axes[i].bar(class_names, counts)
            axes[i].set_title(f'{split.title()} Set Distribution')
            axes[i].set_xlabel('Product Categories')
            axes[i].set_ylabel('Number of Images')
            axes[i].tick_params(axis='x', rotation=45)
    
    plt.tight_layout()
    plt.show()

# Plot class distribution
if any(dataset_info.values()):
    plot_class_distribution(dataset_info)
else:
    print("No data found. Please add images to the data/raw directories.")# Dataset directory analysis
data_dir = Path("../data/raw")

def analyze_dataset_structure(base_dir):
    """Analyze the structure of the dataset."""
    structure_info = {}
    
    for split in ['train', 'val', 'test']:
        split_dir = base_dir / split
        if split_dir.exists():
            structure_info[split] = {}
            for class_dir in split_dir.iterdir():
                if class_dir.is_dir():
                    # Count images in each class
                    image_files = [f for f in class_dir.glob('*') 
                                 if f.suffix.lower() in ['.jpg', '.jpeg', '.png', '.bmp', '.tiff']]
                    structure_info[split][class_dir.name] = len(image_files)
    
    return structure_info

# Analyze dataset structure
